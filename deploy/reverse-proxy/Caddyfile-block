# Ergänzung für ein bereits vorhandenes Caddyfile.
#
# Diesen Block an das bestehende /etc/caddy/Caddyfile anhängen, dann:
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# Das Zertifikat holt Caddy selbstständig.

seo-master.aionepreneur.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy 127.0.0.1:3000 {
		# Ein Analyselauf kann mehrere Minuten dauern.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
