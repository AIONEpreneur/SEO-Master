// SEO-Master – Datenmodell
// Mandantenfähig (Multi-Tenant) von Beginn an: jede Organisation ist ein
// abgeschotteter Datenraum. Notwendig, damit die App später als bezahltes
// SaaS-Produkt für externe Kundinnen betrieben werden kann.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identität & Mandanten
// ---------------------------------------------------------------------------

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String
  isSuperAdmin         Boolean   @default(false)
  /**
   * Dateiname des Profilbilds im Upload-Verzeichnis.
   * Nur der Name, kein Pfad – wo die Dateien liegen, entscheidet der Betrieb
   * über eine Umgebungsvariable, nicht die Datenbank.
   */
  avatarDatei          String?
  /**
   * Wann die Einstiegstour zuletzt abgeschlossen wurde.
   */
  tourGesehenAm        DateTime?
  /**
   * Bis wann die Neuigkeiten gelesen wurden.
   * Der Merker hängt am Konto und nicht am Browser: Wer die Meldung am
   * Rechner weggeklickt hat, soll sie am Telefon nicht noch einmal
   * vorgesetzt bekommen. Leer heisst "noch nie hingesehen" – dann gilt die
   * Anmeldung als Stichtag, damit niemand beim ersten Login von zwei Jahren
   * Änderungshistorie erschlagen wird.
   */
  neuigkeitenGesehenAm DateTime?
  // Gesperrte Konten können sich nicht anmelden; bestehende Sitzungen werden
  // beim Sperren verworfen.
  suspendedAt          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships    Membership[]
  sessions       Session[]
  apiTokens      ApiToken[]
  auditLogs      AuditLog[]
  invitations    Invitation[]    @relation("EingeladenVon")
  passwortHilfen PasswortHilfe[]
  wuensche       Wunsch[]
  neuigkeiten    Neuigkeit[]     @relation("VerfasstVon")

  @@map("users")
}

/**
 * Was sich in der Anwendung geändert hat.
 * Gepflegt vom Betrieb, gelesen von allen. Der Zweck ist nicht Werbung,
 * sondern Verlässlichkeit: Wer eine Woche nicht da war und plötzlich einen
 * neuen Knopf vorfindet, soll nachlesen können, woher er kommt.
 */
model Neuigkeit {
  id                String       @id @default(cuid())
  art               NeuigkeitArt @default(NEU)
  titel             String
  /**
   * Fliesstext, ein bis drei Sätze. Keine Formatierung, keine Überschriften.
   */
  text              String
  /**
   * Ab wann sie sichtbar ist. Getrennt von createdAt, damit sich ein
   * Eintrag vorbereiten lässt, ohne dass er sofort erscheint.
   */
  veroeffentlichtAm DateTime     @default(now())
  verfasstVonId     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  verfasstVon User? @relation("VerfasstVon", fields: [verfasstVonId], references: [id], onDelete: SetNull)

  @@index([veroeffentlichtAm])
  @@map("neuigkeiten")
}

enum NeuigkeitArt {
  NEU
  VERBESSERT
  BEHOBEN
}

/**
 * Ein Wunsch für eine künftige Funktion.
 * Gehört dem Arbeitsbereich, nicht der Anwendung: Eine Kundin sieht ihre
 * eigenen Wünsche und die ihres Teams, nie die einer anderen. Der Betrieb
 * sieht alle – nur so lässt sich erkennen, was mehrfach gewünscht wird.
 */
model Wunsch {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  titel          String
  text           String
  status         WunschStatus @default(OFFEN)
  /**
   * Antwort des Betriebs. Steht beim Wunsch, nicht in einer Mail.
   */
  antwort        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@map("wuensche")
}

enum WunschStatus {
  OFFEN
  GEPLANT
  UMGESETZT
  ABGELEHNT
}

/**
 * Einmal-Link zum Zurücksetzen des Passworts.
 * Der Code steht in der Mail und ist damit ein Schlüssel: Gespeichert wird
 * nur sein Hash, wie bei Sitzungen und Einladungen. Er gilt eine Stunde und
 * genau einmal; eine neue Anforderung entwertet die älteren, damit nie
 * mehrere Links gleichzeitig im Umlauf sind.
 */
model PasswortHilfe {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("passwort_hilfen")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/**
 * Persönlicher Zugangsschlüssel für die Browser-Extension (SEO4U).
 * Anders als eine Sitzung läuft er nicht ab und hängt an keinem Cookie: Die
 * Extension schickt ihn als Bearer-Token mit. Gespeichert wird nur der Hash –
 * der Klartext ist einmal beim Erzeugen sichtbar, wie bei den Einladungen.
 * Widerrufen statt löschen, damit nachvollziehbar bleibt, dass es ihn gab.
 */
model ApiToken {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  name           String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("api_tokens")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(INTERNAL)
  // Guthaben in Credits. 1 Credit ~ 1 externer API-Call-Block; verhindert,
  // dass zahlende Kundinnen unbegrenzt fremde API-Kosten verursachen.
  credits   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Abo bei Stripe -------------------------------------------------------
  // Die Wahrheit über ein Abo steht bei Stripe, nicht hier: Diese Felder sind
  // eine Abschrift, die der Webhook aktuell hält. Sie tragen nie Kartendaten –
  // die sieht diese Anwendung zu keinem Zeitpunkt.
  stripeKundeId      String?   @unique
  stripeAboId        String?
  /**
   * Zustand bei Stripe: active, trialing, past_due, canceled …
   */
  aboStatus          String?
  /**
   * Ende des bezahlten Zeitraums – bis dahin gilt der Zugang.
   */
  aboLaeuftBis       DateTime?
  /**
   * Gekündigt, läuft aber noch bis zum Periodenende.
   */
  aboEndetMitPeriode Boolean   @default(false)

  memberships       Membership[]
  projects          Project[]
  credentials       Credential[]
  analyses          Analysis[]
  auditLogs         AuditLog[]
  usage             UsageRecord[]
  keywordResearches KeywordResearch[]
  invitations       Invitation[]
  erledigteBefunde  ErledigterBefund[]
  wuensche          Wunsch[]
  apiTokens         ApiToken[]
  rankingLookups    RankingLookup[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/**
 * Einladung in die Anwendung.
 * Zwei Fälle, bewusst in einem Modell:
 * - organizationId gesetzt: Aufnahme ins bestehende Team.
 * - organizationId leer:    eigener Arbeitsbereich, der beim Annehmen
 * angelegt wird. Das ist der Kundenfall – die
 * Kundin sieht danach ausschliesslich ihre eigenen
 * Projekte, Analysen und Berichte.
 * Der Code steht in der Einladungs-URL und ist damit ein Schlüssel. Gespeichert
 * wird deshalb nur sein Hash, genau wie bei den Sitzungen. Der Klartext ist
 * einmal beim Erzeugen sichtbar; danach lässt sich die Einladung neu ausstellen,
 * was die alte ungültig macht.
 */
model Invitation {
  id       String @id @default(cuid())
  email    String
  codeHash String @unique
  role     Role   @default(MEMBER)

  // Leer = beim Annehmen wird ein eigener Arbeitsbereich angelegt.
  organizationId      String?
  // Name des anzulegenden Arbeitsbereichs; nur im Kundenfall belegt.
  newOrganizationName String?
  // Tarif und Startguthaben des neuen Arbeitsbereichs.
  plan                Plan    @default(FREE)
  credits             Int     @default(0)

  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?         @relation("EingeladenVon", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([organizationId])
  @@map("invitations")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  INTERNAL
  FREE
  STARTER
  PRO
  AGENCY
}

// ---------------------------------------------------------------------------
// Datentresor: API-Zugangsdaten, verschlüsselt at rest (AES-256-GCM)
// ---------------------------------------------------------------------------

model Credential {
  id              String    @id @default(cuid())
  organizationId  String
  provider        Provider
  label           String
  // Chiffrat des JSON-Secrets. Klartext verlässt niemals den Server und wird
  // nie an den Browser ausgeliefert – die UI sieht ausschliesslich `hint`.
  ciphertext      String
  iv              String
  authTag         String
  keyVersion      Int       @default(1)
  hint            String?
  isActive        Boolean   @default(true)
  lastCheckedAt   DateTime?
  lastCheckOk     Boolean?
  lastCheckError  String?
  /**
   * Was die erfolgreiche Prüfung ergeben hat – etwa die verbundenen
   * Search-Console-Properties oder das Restguthaben. Bei Search Console ist
   * das die wichtigste Angabe überhaupt: Ohne sie ist nicht erkennbar, für
   * welche Seiten gezählte Daten vorliegen und für welche nicht.
   */
  lastCheckDetail String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, label])
  @@index([organizationId])
  @@map("credentials")
}

enum Provider {
  DATAFORSEO
  FIRECRAWL
  APIFY
  ANTHROPIC
  PAGESPEED
  /**
   * Nicht mehr in Verwendung.
   * Der Search-Console-Anschluss wurde entfernt. Der Wert bleibt stehen, weil
   * das Entfernen eines Enum-Werts eine Änderung am Datentyp ist, die bei
   * jedem verbliebenen Verweis fehlschlägt – für einen ungenutzten Wert ein
   * unnötiges Risiko beim Einspielen auf einem laufenden Server.
   */
  SEARCH_CONSOLE
}

// ---------------------------------------------------------------------------
// Projekte: eine Website oder ein Social-Profil, das dauerhaft beobachtet wird
// ---------------------------------------------------------------------------

model Project {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  kind           TargetKind @default(WEBSITE)
  // Website: vollständige URL. Social: Profil-URL.
  url            String
  domain         String?
  /**
   * Der führende Markt. Bleibt bestehen, weil jede einzelne Analyse genau
   * einen Länderindex misst — und weil Bestandsprojekte ihn schon haben.
   */
  locationCode   Int        @default(2276) // Deutschland
  /**
   * Alle Märkte des Projekts, der führende eingeschlossen.
   * Wer für den DACH-Raum arbeitet, trägt hier Deutschland, Österreich und
   * die Schweiz ein. Gemessen wird trotzdem je Land einzeln: Beim
   * Datenanbieter ist das Land die grösste Einheit, und ein Mittelwert über
   * drei Länderindizes entspräche keiner Suchanfrage.
   * Leer heisst: nur der führende Markt. So verhalten sich Projekte, die vor
   * dieser Erweiterung entstanden sind, unverändert.
   */
  locationCodes  Int[]      @default([])
  languageCode   String     @default("de")
  description    String?
  isArchived     Boolean    @default(false)
  // Monatliche Prüfung ohne Zutun: Der Worker stellt fällige Projekte selbst
  // wieder ein. Erst dadurch entsteht der Verlauf, der ein Abo trägt.
  autoPruefung   Boolean    @default(false)
  autoZuletzt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analyses     Analysis[]
  competitors  Competitor[]
  keywords     TrackedKeyword[]

  @@index([organizationId])
  @@map("projects")
}

/**
 * Abgehakte Befunde.
 * Der Schlüssel ist bewusst (Organisation, Adresse, Befund-Kennung) und nicht
 * die Analyse: Ein Häkchen soll den nächsten Lauf überleben. Wer "Title zu
 * kurz" auf seiner Startseite abgehakt hat, hat es für diese Seite erledigt –
 * nicht für einen bestimmten Bericht. Meldet ein späterer Lauf denselben
 * Befund erneut, zeigt die Oberfläche das als Rückfall statt als neues Thema.
 */
model ErledigterBefund {
  id             String   @id @default(cuid())
  organizationId String
  targetUrl      String
  findingId      String
  erledigtVonId  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, targetUrl, findingId])
  @@index([organizationId, targetUrl])
  @@map("erledigte_befunde")
}

enum TargetKind {
  WEBSITE
  SOCIAL_PROFILE
}

model Competitor {
  id        String   @id @default(cuid())
  projectId String
  name      String?
  url       String
  domain    String
  // Automatisch aus SERP-Überschneidung gefunden statt manuell gepflegt.
  isAuto    Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, domain])
  @@index([projectId])
  @@map("competitors")
}

model TrackedKeyword {
  id           String   @id @default(cuid())
  projectId    String
  keyword      String
  searchVolume Int?
  difficulty   Int?
  intent       String?
  createdAt    DateTime @default(now())

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankings KeywordRanking[]

  @@unique([projectId, keyword])
  @@index([projectId])
  @@map("tracked_keywords")
}

model KeywordRanking {
  id           String   @id @default(cuid())
  keywordId    String
  position     Int?
  url          String?
  // Rohdaten des SERP-Eintrags für spätere Auswertungen ohne erneuten API-Call.
  serpFeatures Json?
  checkedAt    DateTime @default(now())

  keyword TrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, checkedAt])
  @@map("keyword_rankings")
}

// ---------------------------------------------------------------------------
// Analysen: ein Lauf über einen oder mehrere Analysebausteine
// ---------------------------------------------------------------------------

model Analysis {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String?
  createdById    String?
  targetUrl      String
  targetKind     TargetKind     @default(WEBSITE)
  // Welche Bausteine laufen sollen: ["SEO","AEO","GEO","SERP","COMPETITORS"]
  modules        String[]
  status         AnalysisStatus @default(QUEUED)
  progress       Int            @default(0)
  currentStep    String?
  error          String?
  jobId          String?

  // Die Parameter des Laufs. Ohne sie liesse sich ein Lauf nicht originalgetreu
  // wiederholen – sie standen bisher nur im Auftrag der Warteschlange, der
  // nach Abschluss verfällt.
  locationCode      Int      @default(2276)
  languageCode      String   @default("de")
  seedKeywords      String[]
  competitorDomains String[]
  // Wie viele Seiten der Lauf höchstens liest. 1 = nur die eingegebene
  // Adresse; mehr = Website-Analyse mit Unterseiten.
  pageLimit         Int      @default(1)

  scoreSeo     Float?
  scoreAeo     Float?
  scoreGeo     Float?
  scoreSerp    Float?
  scoreOverall Float?

  // Vollständiges strukturiertes Ergebnis (siehe src/lib/analysis/types.ts).
  result      Json?
  // Rohantworten der Anbieter, für Nachvollziehbarkeit und Re-Auswertung.
  rawData     Json?
  creditsUsed Int   @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reports      Report[]
  steps        AnalysisStep[]

  @@index([organizationId, createdAt])
  @@index([projectId])
  @@index([status])
  @@map("analyses")
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Einzelschritt eines Laufs – macht sichtbar, welcher Anbieter wie lange
// gebraucht hat und wo ein Lauf gescheitert ist.
model AnalysisStep {
  id         String     @id @default(cuid())
  analysisId String
  key        String
  label      String
  status     StepStatus @default(PENDING)
  provider   Provider?
  message    String?
  durationMs Int?
  startedAt  DateTime?
  finishedAt DateTime?

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("analysis_steps")
}

enum StepStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
  FAILED
}

model Report {
  id          String    @id @default(cuid())
  analysisId  String
  title       String
  // Markdown-Fassung des Berichts – Quelle für HTML- und PDF-Ausgabe.
  markdown    String
  summary     String?
  // Öffentlicher Freigabe-Link (optional, widerrufbar).
  shareToken  String?   @unique
  sharedUntil DateTime?
  createdAt   DateTime  @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Betrieb: Nachvollziehbarkeit und Kostenkontrolle
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Keyword-Recherche: Nachfrage und kaufmännischer Wert zu einem Begriff
// ---------------------------------------------------------------------------

model KeywordResearch {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String?
  /**
   * Der eingegebene Ausgangsbegriff.
   */
  seed           String
  locationCode   Int      @default(2276)
  languageCode   String   @default("de")
  /**
   * Aufbereitete Begriffsliste (KeywordZeile[]).
   */
  rows           Json
  /**
   * Kennzahlen über die gesamte Liste (Zusammenfassung).
   */
  summary        Json
  creditsUsed    Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("keyword_researches")
}

/**
 * Ein bei diesem Server registrierter OAuth-Client (Claude, ChatGPT, …).
 * MCP-Clients registrieren sich selbst (Dynamic Client Registration), bevor
 * sie den Anmelde-Fluss starten. Es sind öffentliche Clients ohne Geheimnis;
 * die Sicherheit liegt in PKCE und der geprüften Rücksprungadresse.
 */
model OAuthClient {
  id           String   @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes OAuthCode[]

  @@map("oauth_clients")
}

/**
 * Einmal-Code aus dem Anmelde-Fluss.
 * Entsteht, wenn eine angemeldete Person den Zugriff bestätigt, und wird am
 * Token-Endpunkt gegen einen Zugangsschlüssel eingetauscht – genau einmal,
 * binnen zehn Minuten, mit PKCE-Nachweis. Gespeichert ist nur der Hash.
 */
model OAuthCode {
  id             String   @id @default(cuid())
  codeHash       String   @unique
  clientId       String
  userId         String
  organizationId String
  redirectUri    String
  codeChallenge  String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_codes")
}

/**
 * Ranking-Abfrage aus der Browser-Extension (SEO4U).
 * Jede Abfrage im Popup – Rankings einer Domain oder einer exakten
 * Unterseite – wird hier abgelegt, damit sie im eigenen Arbeitsbereich
 * wiederauffindbar ist und die Arbeit in der App weitergehen kann.
 */
model RankingLookup {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String?
  /**
   * Domain oder vollständige Adresse der Unterseite.
   */
  target         String
  /**
   * 'domain' oder 'seite' – was abgefragt wurde.
   */
  scope          String   @default("domain")
  locationCode   Int      @default(2276)
  languageCode   String   @default("de")
  /**
   * Rankende Keywords insgesamt (Top 100), auch über die Liste hinaus.
   */
  totalCount     Int      @default(0)
  /**
   * Die abgerufenen Platzierungen ({rank, keyword, sv, path}[]).
   */
  items          Json
  creditsUsed    Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("ranking_lookups")
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  provider       Provider
  operation      String
  units          Int      @default(1)
  costCredits    Int      @default(0)
  analysisId     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("usage_records")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  target         String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
