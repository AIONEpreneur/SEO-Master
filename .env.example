# ---------------------------------------------------------------------------
# SEO-Master – Umgebungskonfiguration
#
# Für den Betrieb: diese Datei nach .env kopieren und ausfüllen.
# Die .env gehört NICHT ins Repository (steht bereits in .gitignore).
# ---------------------------------------------------------------------------

# --- Pflicht ---------------------------------------------------------------

DATABASE_URL="postgresql://seomaster:seomaster@localhost:5432/seomaster"
REDIS_URL="redis://localhost:6379"

# Schlüssel des Datentresors. Verschlüsselt alle API-Zugangsdaten.
# Erzeugen mit:  openssl rand -base64 32
# ACHTUNG: Geht dieser Schlüssel verloren, sind alle hinterlegten
# Zugangsdaten unlesbar und müssen neu eingetragen werden.
ENCRYPTION_KEY=""

# Signiert die Sitzungs-Cookies. Erzeugen mit:  openssl rand -base64 32
SESSION_SECRET=""

APP_URL="http://localhost:3000"

# --- Betrieb ---------------------------------------------------------------

# Solange die App intern läuft: nur diese Adressen dürfen sich registrieren.
# Kommagetrennt. Leer lassen, sobald die App verkauft werden soll.
ALLOWED_SIGNUP_EMAILS=""

# Wie viele Analysen gleichzeitig laufen dürfen.
WORKER_CONCURRENCY="2"

# --- Anbieter --------------------------------------------------------------
#
# Diese Werte sind Rückfallebene für den Einzelbetrieb. Im Mehrmandantenbetrieb
# hinterlegt jede Organisation ihre Schlüssel stattdessen im Datentresor der
# Anwendung – dann können diese Zeilen leer bleiben.

# Suchmaschinendaten: Rankings, SERP, Keywords, Backlinks, Wettbewerb,
# LLM-Sichtbarkeit. https://app.dataforseo.com/api-access
# Das Passwort ist der API-Schlüssel, nicht das Anmeldepasswort.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Seiteninhalt mit ausgeführtem JavaScript. https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=""

# Berichtstexte. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Optional: anderes Modell verwenden.
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Social-Profile (Instagram, LinkedIn, TikTok, YouTube, Facebook, X).
# https://console.apify.com/settings/integrations
APIFY_TOKEN=""

# Optional: andere Actors verwenden, falls sich ein Actor im Store ändert.
# APIFY_ACTOR_INSTAGRAM="apify/instagram-profile-scraper"
# APIFY_ACTOR_LINKEDIN="dev_fusion/linkedin-profile-scraper"
# APIFY_ACTOR_TIKTOK="clockworks/tiktok-profile-scraper"

# Ladegeschwindigkeit. Funktioniert auch ohne Schlüssel, dann mit engem Limit.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=""

# --- Nur für den VPS-Betrieb (docker-compose.prod.yml) ---------------------

DOMAIN="seo.meine-domain.de"
POSTGRES_USER="seomaster"
POSTGRES_PASSWORD=""
POSTGRES_DB="seomaster"
